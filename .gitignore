# Not part of the alignment software itself (comments must be on their own lines in .gitignore)

# Per-workstation profile overrides (deep-merged over profiles/<name>/default_config.json)
profiles/*/active_config.json

# Raw beamline scans (GBs)
s1_data/
# Exploratory figures and cached per-frame fits
analysis/
# Alignment run logs, frames, live.jpg (regenerated by every run)
runs/
# Cloned reference repos etc.
scratch/

# Python / OS noise
__pycache__/
*.pyc
.DS_Store

# Packaging artefacts
build/
*.egg-info/
dist/

# Beamline-twin reference photos (local only: screens show hostnames/IPs/usernames; the tracked index is sources/photos.json)
beamline_twins/*/sources/photos/

# Experiment-log index (extracted text + SQLite from users' unpublished experiment logs; local only)
beamline_twins/*/logs_index/

# Agent context (local only; not published)
AGENTS.md
.context/
